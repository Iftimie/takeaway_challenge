{
  "name": "takeaway-ui-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pretest:browser": "npm run build",
    "pretest:trace": "npm run build",
    "test:unit": "node --test tests/ui-unit/*.test.js",
