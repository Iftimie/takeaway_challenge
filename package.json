    "test:trace": "playwright test --trace on",
    "trace": "node scripts/show-trace.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.3.0"
  },
  "dependencies": {
    "vue": "3.5.13"
  }
}
