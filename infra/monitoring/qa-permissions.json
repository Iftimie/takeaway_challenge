{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishEnvironmentAppLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
