# Local development only. Copy to .env before starting Compose.
POSTGRES_DB=takeaway
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=takeaway_local_only
# Change this host port if 5432 is already in use.
POSTGRES_PORT=5432
# Python connects through the port published by Docker on this computer.
POSTGRES_HOST=127.0.0.1
# Generate a private signing key as described in README.md (no shared default).
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
# Nginx publishes the full Compose application on this localhost port.
HTTP_PORT=8080
